      <column caption='Attrition Count' datatype='integer' name='[Calculation_0091593277898752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Attrition]=&quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='New Hires' datatype='integer' name='[Calculation_0309846703136768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Employee Number])' />
      </column>
      <column caption='Donut Circle' datatype='integer' name='[Calculation_0530848875622400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Active Employee' datatype='integer' name='[Calculation_0530848891252737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Attrition] = &quot;No&quot;, 1, 0))' />
      </column>
      <column caption='age group' datatype='string' name='[Calculation_1281265421750272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &quot;Under 25&quot;&#13;&#10;ELSEIF [Age] &lt; 35 THEN &quot;25–34&quot;&#13;&#10;ELSEIF [Age] &lt; 45 THEN &quot;35–44&quot;&#13;&#10;ELSEIF [Age] &lt; 55 THEN &quot;45–54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Attrition' datatype='integer' name='[Calculation_1281265462870017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Attrition] = &quot;Yes&quot;&#13;&#10;    THEN [Employee Number]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Overtime Attrition' datatype='integer' name='[Calculation_1281265464299522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Over Time] = &quot;Yes&quot;&#13;&#10;       AND [Attrition] = &quot;Yes&quot;&#13;&#10;    THEN [Employee Number]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Attrition Rate' datatype='real' name='[Calculation_1334041765654529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Attrition] = &quot;Yes&quot;&#13;&#10;    THEN [Employee Number]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Employee Number])' />
